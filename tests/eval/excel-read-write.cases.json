{
  "flow": "tests/eval/fixtures/excel-read-write.json",
  "description": "Requirement: check whether Excel has data, and write a marker and save when it does",
  "cases": [
    {
      "id": "open-read-close",
      "requirement": "Must open the workbook, read data, and finally save and close",
      "expect": [
        { "op": "action", "id": "1", "padHint": "Excel.LaunchExcel.LaunchAndOpen" },
        { "op": "action", "id": "2", "padHint": "Excel.ReadFromExcel.ReadAllCells" },
        { "op": "action", "id": "5", "padHint": "Excel.CloseExcel.CloseAndSave" }
      ]
    },
    {
      "id": "write-only-when-data",
      "requirement": "Write the marker only when data was read; empty sheets are left untouched",
      "expect": [
        { "op": "condition", "id": "3", "contains": "Rows.Count > 0" },
        { "op": "edge", "from": "3", "to": "4" }
      ]
    }
  ]
}
