{
  "name": "normalize-text",
  "description": "Read a text file and write it verbatim to another file (synthetic sample)",
  "trigger": { "kind": "manual" },
  "budget": { "maxLoop": 1 },
  "variables": [
    { "name": "InputFile", "type": "string", "default": "C:\\Temp\\input.txt" },
    { "name": "OutputFile", "type": "string", "default": "C:\\Temp\\output.txt" }
  ],
  "edges": [
    { "from": "1", "to": "2" }
  ],
  "nodes": [
    {
      "id": "1",
      "label": "Read source file",
      "type": "action",
      "pad_hint": "File.ReadTextFromFile.ReadText",
      "params": {
        "File": "{{variables.InputFile}}",
        "Encoding": "UTF8"
      },
      "output_map": { "Content": "FileContent" },
      "next": ["2"],
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "2",
      "label": "Write to target file",
      "type": "action",
      "pad_hint": "File.WriteText",
      "params": {
        "File": "{{variables.OutputFile}}",
        "TextToWrite": "{{1.FileContent}}",
        "IfFileExists": "Overwrite",
        "AppendNewLine": false,
        "Encoding": "UTF8"
      },
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    }
  ]
}
