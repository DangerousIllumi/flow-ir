{
  "name": "input-files",
  "description": "在读取前声明本步骤需要的输入文件（合成样例）",
  "trigger": { "kind": "manual" },
  "budget": { "maxLoop": 1 },
  "variables": [
    { "name": "InputFile", "type": "string", "default": "C:\\Temp\\input.csv" },
    { "name": "OutputFile", "type": "string", "default": "C:\\Temp\\output.csv" }
  ],
  "edges": [
    { "from": "1", "to": "2" }
  ],
  "nodes": [
    {
      "id": "1",
      "label": "读取输入文件",
      "type": "action",
      "pad_hint": "File.ReadTextFromFile.ReadText",
      "inputs": [
        { "dir": "{{config.InputDir}}", "pattern": "*.csv", "required": true },
        { "dir": "{{config.ReferenceDir}}", "pattern": "reference-*.csv", "required": false }
      ],
      "params": { "File": "{{variables.InputFile}}", "Encoding": "UTF8" },
      "output_map": { "Content": "FileContent" },
      "next": ["2"],
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "2",
      "label": "写出结果",
      "type": "action",
      "pad_hint": "File.WriteText",
      "params": {
        "File": "{{variables.OutputFile}}",
        "TextToWrite": "{{1.FileContent}}",
        "IfFileExists": "Overwrite",
        "AppendNewLine": false,
        "Encoding": "UTF8"
      },
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    }
  ]
}
