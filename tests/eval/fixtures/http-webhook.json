{
  "name": "http-webhook-notify",
  "description": "POST a JSON payload to a webhook and branch on the status code (synthetic sample)",
  "trigger": {
    "kind": "schedule",
    "task_name": "flow-ir-sample-http-webhook",
    "time": "18:30",
    "days": ["mon", "tue", "wed", "thu", "fri"],
    "gate": "workday"
  },
  "budget": { "maxLoop": 1 },
  "variables": [
    { "name": "WebhookUrl", "type": "string", "default": "https://example.com/hook" }
  ],
  "edges": [
    { "from": "1", "to": "2" },
    { "from": "2", "to": "3", "label": "yes" },
    { "from": "2", "to": "4", "label": "no" }
  ],
  "nodes": [
    {
      "id": "1",
      "label": "POST notification",
      "type": "action",
      "pad_hint": "Web.InvokeWebService.InvokeWebServicePost",
      "params": {
        "Url": "{{variables.WebhookUrl}}",
        "ContentType": "application/json",
        "Accept": "application/json",
        "UserAgent": "pad-agent",
        "RequestBody": "{\"text\":\"job done\"}",
        "EncodeRequestBody": true,
        "TrimRequestBody": true,
        "ClearCookies": false,
        "FailOnErrorStatus": true,
        "ConnectionTimeout": 30,
        "FollowRedirection": true,
        "Encoding": "AutoDetect",
        "AcceptUntrustedCertificates": false
      },
      "output_map": { "StatusCode": "HttpStatus", "Response": "HttpBody" },
      "next": ["2"],
      "run_mode": "auto",
      "idempotent": false,
      "reversible": false,
      "reversibility_note": "对端已收到请求，无法确认能否回滚",
      "idempotency_note": "重跑会再次 POST 同一批数据，对端可能产生重复记录"
    },
    {
      "id": "2",
      "label": "Treat only HTTP 200 as success",
      "type": "if",
      "pad_hint": "IF",
      "params": { "Condition": "HttpStatus = 200" },
      "branch": { "trueBody": ["3"], "falseBody": ["4"] },
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "3",
      "label": "Notification succeeded",
      "type": "action",
      "pad_hint": "Display.ShowMessageDialog.ShowMessage",
      "params": {
        "Message": "已通知", "Title": "结果", "Icon": "Information",
        "Buttons": "OK", "DefaultButton": "Button1", "IsTopMost": true
      },
      "output_map": { "ButtonPressed": "OkButton" },
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "4",
      "label": "Notification failed",
      "type": "action",
      "pad_hint": "Display.ShowMessageDialog.ShowMessage",
      "params": {
        "Message": "通知失败", "Title": "结果", "Icon": "ErrorIcon",
        "Buttons": "OK", "DefaultButton": "Button1", "IsTopMost": true
      },
      "output_map": { "ButtonPressed": "FailButton" },
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    }
  ]
}
