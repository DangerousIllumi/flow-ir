{
  "name": "run-script-three-way",
  "description": "Run a script and branch three ways on its exit code (synthetic sample)",
  "trigger": {
    "kind": "schedule",
    "task_name": "flow-ir-sample-switch-exit-code",
    "time": "09:00",
    "days": ["mon", "tue", "wed", "thu", "fri"],
    "gate": "workday"
  },
  "budget": { "maxLoop": 1 },
  "variables": [
    { "name": "ScriptPath", "type": "string", "default": "C:\\Temp\\job.cmd" },
    { "name": "WorkDir", "type": "string", "default": "C:\\Temp" }
  ],
  "edges": [
    { "from": "1", "to": "2" },
    { "from": "2", "to": "3", "label": "= 0" },
    { "from": "2", "to": "4", "label": "= 2" },
    { "from": "2", "to": "5", "label": "default" }
  ],
  "nodes": [
    {
      "id": "1",
      "label": "Run script",
      "type": "action",
      "pad_hint": "Scripting.RunDOSCommand.RunDOSCommand",
      "intent": "run-job",
      "params": {
        "DOSCommandOrApplication": "cmd.exe /c \"\"{{variables.ScriptPath}}\"\"",
        "WorkingDirectory": "{{variables.WorkDir}}"
      },
      "output_map": { "ExitCode": "ExitCode" },
      "next": ["2"],
      "run_mode": "auto",
      "idempotent": false,
      "reversible": false,
      "reversibility_note": "脚本副作用由被调脚本决定，无法自动回退",
      "idempotency_note": "重跑会再执行一次同一命令，副作用取决于脚本本身"
    },
    {
      "id": "2",
      "label": "Branch on exit code",
      "type": "switch",
      "pad_hint": "SWITCH",
      "switch": {
        "expression": "ExitCode",
        "cases": [
          { "case": "= 0", "body": ["3"] },
          { "case": "= 2", "body": ["4"] }
        ],
        "default": ["5"]
      },
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "3",
      "label": "Success",
      "type": "action",
      "pad_hint": "Display.ShowMessageDialog.ShowMessage",
      "params": {
        "Message": "完成", "Title": "结果", "Icon": "Information",
        "Buttons": "OK", "DefaultButton": "Button1", "IsTopMost": true
      },
      "output_map": { "ButtonPressed": "OkButton" },
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "4",
      "label": "Differences found",
      "type": "action",
      "pad_hint": "Display.ShowMessageDialog.ShowMessage",
      "params": {
        "Message": "有差异", "Title": "结果", "Icon": "Warning",
        "Buttons": "OK", "DefaultButton": "Button1", "IsTopMost": true
      },
      "output_map": { "ButtonPressed": "DiffButton" },
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "5",
      "label": "Error",
      "type": "action",
      "pad_hint": "Display.ShowMessageDialog.ShowMessage",
      "params": {
        "Message": "异常", "Title": "结果", "Icon": "ErrorIcon",
        "Buttons": "OK", "DefaultButton": "Button1", "IsTopMost": true
      },
      "output_map": { "ButtonPressed": "FailButton" },
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    }
  ]
}
