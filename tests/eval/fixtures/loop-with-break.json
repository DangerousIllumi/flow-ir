{
  "name": "loop-with-break",
  "description": "Bounded loop that exits early when the condition is met (synthetic sample)",
  "trigger": {
    "kind": "schedule",
    "task_name": "flow-ir-sample-loop-with-break",
    "time": "08:00",
    "days": ["mon", "tue", "wed", "thu", "fri"],
    "gate": "workday"
  },
  "budget": { "maxLoop": 5 },
  "variables": [
    { "name": "Threshold", "type": "number", "default": 3 }
  ],
  "edges": [
    { "from": "1", "to": "2", "label": "loop body" },
    { "from": "1", "to": "4", "label": "end loop" },
    { "from": "2", "to": "3", "label": "yes" }
  ],
  "nodes": [
    {
      "id": "1",
      "label": "Retry at most 5 times",
      "type": "loop",
      "pad_hint": "LOOP",
      "loop": { "kind": "fromto", "index": "Idx", "from": 1, "to": 5, "step": 1, "body": ["2"] },
      "next": ["4"],
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "2",
      "label": "Stop when the threshold is reached",
      "type": "if",
      "pad_hint": "IF",
      "params": { "Condition": "Idx >= Threshold" },
      "branch": { "trueBody": ["3"], "falseBody": [] },
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "3",
      "label": "Exit loop",
      "type": "break",
      "pad_hint": "EXIT LOOP",
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "4",
      "label": "Done notification",
      "type": "action",
      "pad_hint": "Display.ShowMessageDialog.ShowMessage",
      "params": {
        "Message": "循环结束",
        "Title": "完成",
        "Icon": "Information",
        "Buttons": "OK",
        "DefaultButton": "Button1",
        "IsTopMost": true
      },
      "output_map": { "ButtonPressed": "DoneButton" },
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    }
  ]
}
