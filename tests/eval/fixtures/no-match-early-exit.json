{
  "name": "no-match-early-exit",
  "description": "Poll the inbox and stop early on receipt; notify only when nothing ever arrives (synthetic sample)",
  "trigger": {
    "kind": "schedule",
    "task_name": "flow-ir-sample-no-match-early-exit",
    "time": "09:00",
    "days": ["mon", "tue", "wed", "thu", "fri"],
    "gate": "workday"
  },
  "budget": { "maxLoop": 3 },
  "variables": [
    { "name": "MailAccount", "type": "string", "default": "" }
  ],
  "edges": [
    { "from": "1", "to": "2" },
    { "from": "2", "to": "3", "label": "loop body" },
    { "from": "2", "to": "6", "label": "end loop" },
    { "from": "3", "to": "4" },
    { "from": "4", "to": "5", "label": "yes" },
    { "from": "6", "to": "7", "label": "yes" }
  ],
  "nodes": [
    {
      "id": "1",
      "label": "Launch Outlook",
      "type": "action",
      "pad_hint": "Outlook.Launch",
      "params": {},
      "next": ["2"],
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "2",
      "label": "Check at most 3 times",
      "type": "loop",
      "pad_hint": "LOOP",
      "loop": { "kind": "fromto", "index": "Idx", "from": 1, "to": 3, "step": 1, "body": ["3"] },
      "next": ["6"],
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "3",
      "label": "Check unread emails",
      "type": "action",
      "pad_hint": "Outlook.RetrieveEmailMessages.RetrieveEmails",
      "params": {
        "MailFolder": "收件箱",
        "EmailsToRetrieve": "Unread",
        "MarkAsRead": true,
        "ReadBodyAsHtml": false,
        "Account": "{{variables.MailAccount}}"
      },
      "output_map": { "Messages": "RetrievedEmails" },
      "next": ["4"],
      "run_mode": "auto",
      "idempotent": false,
      "reversible": true,
      "idempotency_note": "首轮已把邮件标记为已读，重跑可能取不到同一封邮件"
    },
    {
      "id": "4",
      "label": "Stop on receipt",
      "type": "if",
      "pad_hint": "IF",
      "params": { "Condition": "RetrievedEmails.Count > 0" },
      "branch": { "trueBody": ["5"], "falseBody": [] },
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "5",
      "label": "End polling early",
      "type": "break",
      "pad_hint": "EXIT LOOP",
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "6",
      "label": "Nothing received",
      "type": "if",
      "pad_hint": "IF",
      "params": { "Condition": "RetrievedEmails.Count = 0" },
      "branch": { "trueBody": ["7"], "falseBody": [] },
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "7",
      "label": "Show no-mail notice",
      "type": "action",
      "pad_hint": "Display.ShowMessageDialog.ShowMessage",
      "params": {
        "Message": "未收到邮件", "Title": "提示", "Icon": "Warning",
        "Buttons": "OK", "DefaultButton": "Button1", "IsTopMost": true
      },
      "output_map": { "ButtonPressed": "NoMailButton" },
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    }
  ]
}
