{
  "name": "excel-read-write",
  "description": "Open Excel, read all data, write one marker row only when data exists, then save (synthetic sample)",
  "trigger": {
    "kind": "schedule",
    "task_name": "flow-ir-sample-excel-read-write",
    "time": "07:00",
    "days": ["mon", "tue", "wed", "thu", "fri"],
    "gate": "workday"
  },
  "budget": { "maxLoop": 1 },
  "variables": [
    { "name": "ExcelPath", "type": "string", "default": "C:\\Temp\\report.xlsx" }
  ],
  "edges": [
    { "from": "1", "to": "2" },
    { "from": "2", "to": "3" },
    { "from": "3", "to": "4", "label": "yes" },
    { "from": "3", "to": "5", "label": "no" },
    { "from": "4", "to": "5" }
  ],
  "nodes": [
    {
      "id": "1",
      "label": "Open workbook",
      "type": "action",
      "pad_hint": "Excel.LaunchExcel.LaunchAndOpen",
      "params": {
        "Path": "{{variables.ExcelPath}}",
        "Visible": false,
        "ReadOnly": false,
        "LoadAddInsAndMacros": false,
        "UseMachineLocale": false
      },
      "next": ["2"],
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "2",
      "label": "Read all data",
      "type": "action",
      "pad_hint": "Excel.ReadFromExcel.ReadAllCells",
      "params": {
        "FirstLineIsHeader": true,
        "GetCellContentsMode": "TypedValues"
      },
      "output_map": { "RangeValue": "Rows" },
      "next": ["3"],
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "3",
      "label": "Write marker only when data exists",
      "type": "if",
      "pad_hint": "IF",
      "params": { "Condition": "Rows.Count > 0" },
      "branch": { "trueBody": ["4"], "falseBody": [] },
      "next": ["5"],
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "4",
      "label": "Write one marker row",
      "type": "action",
      "pad_hint": "Excel.WriteToExcel.WriteCell",
      "params": { "Column": "A", "Row": 2, "Value": "$'''checked'''" },
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "5",
      "label": "Save and close",
      "type": "action",
      "pad_hint": "Excel.CloseExcel.CloseAndSave",
      "params": {},
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    }
  ]
}
