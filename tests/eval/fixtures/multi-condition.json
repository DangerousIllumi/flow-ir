{
  "name": "multi-condition-branch",
  "description": "Process only when both conditions hold (synthetic sample)",
  "trigger": {
    "kind": "schedule",
    "task_name": "flow-ir-sample-multi-condition",
    "time": "08:30",
    "days": ["mon", "tue", "wed", "thu", "fri"],
    "gate": "workday"
  },
  "budget": { "maxLoop": 1 },
  "variables": [
    { "name": "SourceDir", "type": "string", "default": "C:\\Temp\\inbox" },
    { "name": "Enabled", "type": "boolean", "default": true }
  ],
  "edges": [
    { "from": "1", "to": "2" },
    { "from": "2", "to": "3", "label": "yes" },
    { "from": "2", "to": "4", "label": "no" }
  ],
  "nodes": [
    {
      "id": "1",
      "label": "List pending files",
      "type": "action",
      "pad_hint": "Folder.GetFiles",
      "params": {
        "Folder": "{{variables.SourceDir}}",
        "FileFilter": "*.xlsx",
        "IncludeSubfolders": false,
        "FailOnAccessDenied": false
      },
      "output_map": { "Files": "Files" },
      "next": ["2"],
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "2",
      "label": "Process only when enabled and files exist",
      "type": "if",
      "pad_hint": "IF",
      "params": { "Condition": "Enabled = $'''True''' AND Files.Count > 0" },
      "branch": { "trueBody": ["3"], "falseBody": ["4"] },
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "3",
      "label": "Start processing",
      "type": "action",
      "pad_hint": "Display.ShowMessageDialog.ShowMessage",
      "params": {
        "Message": "开始处理", "Title": "处理中", "Icon": "Information",
        "Buttons": "OK", "DefaultButton": "Button1", "IsTopMost": true
      },
      "output_map": { "ButtonPressed": "StartButton" },
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "4",
      "label": "Skip",
      "type": "action",
      "pad_hint": "Display.ShowMessageDialog.ShowMessage",
      "params": {
        "Message": "条件不满足，跳过", "Title": "跳过", "Icon": "Warning",
        "Buttons": "OK", "DefaultButton": "Button1", "IsTopMost": true
      },
      "output_map": { "ButtonPressed": "SkipButton" },
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    }
  ]
}
