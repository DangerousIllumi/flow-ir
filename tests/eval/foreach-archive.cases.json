{
  "flow": "tests/eval/fixtures/foreach-archive.json",
  "description": "Requirement: periodically archive CSVs from the downloads directory",
  "cases": [
    {
      "id": "foreach-over-files",
      "requirement": "Process each CSV in the directory one by one, not just the first one",
      "expect": [
        { "op": "loop", "id": "2", "kind": "foreach", "item": "Item" },
        { "op": "action", "id": "1", "padHint": "Folder.GetFiles" },
        { "op": "edge", "from": "2", "to": "3" }
      ]
    },
    {
      "id": "move-overwrite",
      "requirement": "Overwrite same-name files directly instead of aborting when the file already exists",
      "expect": [
        { "op": "param", "id": "3", "name": "IfFileExists", "equals": "Overwrite" }
      ]
    },
    {
      "id": "finish-notice",
      "requirement": "Show one completion notice after archiving",
      "expect": [
        { "op": "action", "id": "4", "padHint": "Display.ShowMessageDialog.ShowMessage" }
      ]
    }
  ]
}
