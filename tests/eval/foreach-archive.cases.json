{
  "flow": "tests/eval/fixtures/foreach-archive.json",
  "description": "需求：定期把下载目录里的 CSV 归档",
  "cases": [
    {
      "id": "foreach-over-files",
      "requirement": "把目录里的 CSV 逐个处理（不是只处理第一个）",
      "expect": [
        { "op": "loop", "id": "2", "kind": "foreach", "item": "Item" },
        { "op": "action", "id": "1", "padHint": "Folder.GetFiles" },
        { "op": "edge", "from": "2", "to": "3" }
      ]
    },
    {
      "id": "move-overwrite",
      "requirement": "同名文件直接覆盖，不能因为已存在就中断",
      "expect": [
        { "op": "param", "id": "3", "name": "IfFileExists", "equals": "Overwrite" }
      ]
    },
    {
      "id": "finish-notice",
      "requirement": "归档结束后提示一次",
      "expect": [
        { "op": "action", "id": "4", "padHint": "Display.ShowMessageDialog.ShowMessage" }
      ]
    }
  ]
}
