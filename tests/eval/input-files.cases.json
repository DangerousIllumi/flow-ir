{
  "flow": "tests/eval/fixtures/input-files.json",
  "description": "Requirement: step N declares and verifies only the input files needed by step N (directory + file pattern + required/optional)",
  "cases": [
    {
      "id": "inputs-declared",
      "requirement": "The read step declares one required and one optional input, with a valid declaration shape",
      "expect": [{ "op": "inputs" }]
    },
    {
      "id": "inputs-single-node",
      "requirement": "Validating only the specified node also passes",
      "expect": [{ "op": "inputs", "node": "1" }]
    },
    {
      "id": "inputs-path-literal",
      "requirement": "A hard-coded literal directory path must be rejected (INPUT_PATH_LITERAL)",
      "expect": [
        {
          "op": "inputs",
          "def": [{ "dir": "<输入目录>/inbox", "pattern": "*.csv", "required": true }],
          "expect": "invalid",
          "code": "INPUT_PATH_LITERAL"
        }
      ]
    },
    {
      "id": "inputs-required-not-explicit",
      "requirement": "An omitted required field must be rejected (INPUT_INVALID, no default fill)",
      "expect": [
        {
          "op": "inputs",
          "def": [{ "dir": "{{config.InputDir}}", "pattern": "*.csv" }],
          "expect": "invalid",
          "code": "INPUT_INVALID"
        }
      ]
    },
    {
      "id": "inputs-empty-pattern",
      "requirement": "An empty pattern must be rejected (INPUT_INVALID)",
      "expect": [
        {
          "op": "inputs",
          "def": [{ "dir": "{{config.InputDir}}", "pattern": "  ", "required": true }],
          "expect": "invalid",
          "code": "INPUT_INVALID"
        }
      ]
    },
    {
      "id": "inputs-undeclared",
      "requirement": "Legacy flows without inputs: emit one INPUT_UNDECLARED warning, not a failure",
      "flow": "tests/eval/fixtures/file-copy-text.json",
      "expect": [{ "op": "inputs", "expect": "warning", "code": "INPUT_UNDECLARED" }]
    }
  ]
}
