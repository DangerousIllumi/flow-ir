{
  "flow": "tests/eval/fixtures/trigger-manual.json",
  "description": "Requirement: the launch mode must be declared in flow.json and validated statically",
  "cases": [
    {
      "id": "trigger-manual-minimal",
      "requirement": "Minimal manual declaration is valid",
      "expect": [{ "op": "trigger" }]
    },
    {
      "id": "trigger-schedule-full",
      "requirement": "Complete schedule declaration is valid (no TRIGGER error)",
      "expect": [
        {
          "op": "trigger",
          "def": {
            "kind": "schedule",
            "task_name": "flow-ir-sample-schedule",
            "time": "09:00",
            "days": ["mon", "tue", "wed", "thu", "fri"],
            "gate": "workday",
            "timeout_sec": 4200
          }
        }
      ]
    },
    {
      "id": "trigger-file-full",
      "requirement": "Complete file declaration is valid (the directory must be a config reference)",
      "expect": [
        {
          "op": "trigger",
          "def": {
            "kind": "file",
            "task_name": "flow-ir-sample-file",
            "time": "08:30",
            "days": ["mon", "tue", "wed", "thu", "fri"],
            "file": {
              "dir": "{{config.AttachmentDir}}",
              "pattern": "*.xlsx",
              "poll_sec": 60,
              "settle_sec": 60,
              "max_wait_sec": 7200,
              "once_per_file": true
            }
          }
        }
      ]
    },
    {
      "id": "trigger-complete",
      "requirement": "The flow declares its own trigger (triggerComplete passes)",
      "expect": [{ "op": "triggerComplete" }]
    },
    {
      "id": "trigger-kind-mail",
      "requirement": "kind=mail must be rejected (TRIGGER_KIND_UNSUPPORTED)",
      "expect": [{ "op": "trigger", "def": { "kind": "mail" }, "expect": "invalid", "code": "TRIGGER_KIND_UNSUPPORTED" }]
    },
    {
      "id": "trigger-file-literal-path",
      "requirement": "A hard-coded file.dir path must be rejected (TRIGGER_PATH_LITERAL)",
      "expect": [
        {
          "op": "trigger",
          "def": {
            "kind": "file",
            "time": "08:30",
            "file": { "dir": "<附件目录>/inbox", "pattern": "*.xlsx" }
          },
          "expect": "invalid",
          "code": "TRIGGER_PATH_LITERAL"
        }
      ]
    },
    {
      "id": "trigger-schedule-missing-time",
      "requirement": "schedule without time must be rejected (TRIGGER_INVALID)",
      "expect": [
        { "op": "trigger", "def": { "kind": "schedule" }, "expect": "invalid", "code": "TRIGGER_INVALID" }
      ]
    },
    {
      "id": "trigger-confirm-under-schedule",
      "requirement": "schedule trigger with a run_mode=confirm node must be rejected (TRIGGER_UNATTENDED_CONFIRM)",
      "flow": "tests/eval/fixtures/trigger-schedule-confirm.json",
      "expect": [
        { "op": "trigger", "expect": "invalid", "code": "TRIGGER_UNATTENDED_CONFIRM" }
      ]
    },
    {
      "id": "trigger-assisted-confirm-under-schedule",
      "requirement": "With assisted=true, a schedule trigger plus a confirm node is valid (attended mid-run)",
      "flow": "tests/eval/fixtures/trigger-schedule-assisted.json",
      "expect": [{ "op": "trigger" }]
    },
    {
      "id": "trigger-assisted-no-timeout",
      "requirement": "assisted=true without timeout_sec must be rejected (TRIGGER_ASSISTED_NO_TIMEOUT)",
      "expect": [
        {
          "op": "trigger",
          "def": {
            "kind": "schedule",
            "time": "09:00",
            "days": ["mon", "tue", "wed", "thu", "fri"],
            "gate": "workday",
            "assisted": true
          },
          "expect": "invalid",
          "code": "TRIGGER_ASSISTED_NO_TIMEOUT"
        }
      ]
    },
    {
      "id": "trigger-manual-with-assisted",
      "requirement": "manual with assisted must be rejected (TRIGGER_INVALID)",
      "expect": [
        { "op": "trigger", "def": { "kind": "manual", "assisted": true }, "expect": "invalid", "code": "TRIGGER_INVALID" }
      ]
    },
    {
      "id": "trigger-reversible-all-true",
      "requirement": "No reversibility warning when all nodes are reversible=true (positive case)",
      "flow": "tests/eval/fixtures/trigger-schedule-reversible.json",
      "expect": [{ "op": "trigger" }]
    },
    {
      "id": "trigger-irreversible-node",
      "requirement": "schedule trigger with a reversible=false node must report TRIGGER_UNATTENDED_IRREVERSIBLE",
      "flow": "tests/eval/fixtures/trigger-schedule-irreversible.json",
      "expect": [
        { "op": "trigger", "expect": "invalid", "code": "TRIGGER_UNATTENDED_IRREVERSIBLE" }
      ]
    },
    {
      "id": "trigger-missing-reversibility",
      "requirement": "idempotent=false without a declared reversible must report TRIGGER_MISSING_REVERSIBILITY",
      "flow": "tests/eval/fixtures/trigger-schedule-missing-reversibility.json",
      "expect": [
        { "op": "trigger", "expect": "invalid", "code": "TRIGGER_MISSING_REVERSIBILITY" }
      ]
    }
  ]
}
