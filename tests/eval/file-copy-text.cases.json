{
  "flow": "tests/eval/fixtures/file-copy-text.json",
  "description": "Requirement: copy a text file verbatim to another location",
  "cases": [
    {
      "id": "read-then-write",
      "requirement": "Read the source file first, then write the target file",
      "expect": [
        { "op": "action", "id": "1", "padHint": "File.ReadTextFromFile.ReadText" },
        { "op": "action", "id": "2", "padHint": "File.WriteText" },
        { "op": "edge", "from": "1", "to": "2" }
      ]
    },
    {
      "id": "content-passed-through",
      "requirement": "The written content comes from the previous read result, not an empty string",
      "expect": [
        { "op": "param", "id": "2", "name": "TextToWrite", "equals": "{{1.FileContent}}" }
      ]
    }
  ]
}
