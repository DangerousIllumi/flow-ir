{
  "flow": "tests/eval/fixtures/http-webhook.json",
  "description": "Requirement: POST a notification after the job completes and make failures visible",
  "cases": [
    {
      "id": "post-with-json-body",
      "requirement": "Send JSON via POST with content type application/json",
      "expect": [
        { "op": "action", "id": "1", "padHint": "Web.InvokeWebService.InvokeWebServicePost" },
        { "op": "param", "id": "1", "name": "ContentType", "equals": "application/json" },
        { "op": "param", "id": "1", "name": "Url", "equals": "{{variables.WebhookUrl}}" }
      ]
    },
    {
      "id": "status-code-branch",
      "requirement": "Distinguish success from failure by HTTP status code",
      "expect": [
        { "op": "condition", "id": "2", "contains": "HttpStatus = 200" },
        { "op": "edge", "from": "2", "to": "4" }
      ]
    }
  ]
}
