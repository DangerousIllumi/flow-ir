#!/bin/sh
# pre-commit - entry point for the public-content gate before each commit (Git for Windows runs hooks with sh)
# The real logic lives in pre-commit.ps1: it scans only the staged snapshot and exits non-zero to block the commit.
hook_dir=$(dirname "$0")
exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$hook_dir/pre-commit.ps1"
