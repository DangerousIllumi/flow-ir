{
  "name": "monthly-reconciliation",
  "description": "Sample reconciliation: read attachments from the mailbox, extract amounts, compare them with the exported data, highlight differences in red, then email the recipient",
  "trigger": {
    "kind": "schedule",
    "task_name": "flow-ir-monthly-reconciliation",
    "time": "09:00",
    "gate": "last-workday",
    "timeout_sec": 4200
  },
  "budget": {
    "maxLoop": 1,
    "note": "The sample flow does not poll; it only demonstrates the structure"
  },
  "variables": [
    {
      "name": "ManagerEmail",
      "type": "string",
      "default": "user@example.com",
      "description": "Recipient mailbox",
      "required": true
    },
    {
      "name": "SenderFilter",
      "type": "string",
      "default": "sender@example.com",
      "description": "Sender filter",
      "required": true
    },
    {
      "name": "Month",
      "type": "string",
      "default": "2026-09",
      "description": "Reconciliation month",
      "required": true
    },
    {
      "name": "ExcelPath",
      "type": "string",
      "default": "<EXPORT_DIR>\\export.xlsx",
      "description": "Path of the Excel export from SAP",
      "required": true
    }
  ],
  "nodes": [
    {
      "id": "1",
      "type": "mail.launch",
      "pad_hint": "Outlook.Launch",
      "label": "Launch Outlook",
      "params": {},
      "outputs": [
        "OutlookInstance"
      ],
      "next": [
        "2"
      ],
      "branch": null,
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "2",
      "type": "mail.search",
      "pad_hint": "Outlook.RetrieveEmailMessages.RetrieveEmailsAndSaveAttachments",
      "label": "Find the sample report email and save its attachments",
      "params": {
        "MarkAsRead": true,
        "MailFolder": "收件箱",
        "FromContains": "{{variables.SenderFilter}}",
        "SubjectContains": "报表",
        "SaveAttachmentsInto": "<PAD_ROOT>\\Attachments"
      },
      "output_skip": [
        "Messages"
      ],
      "next": [
        "3"
      ],
      "branch": null,
      "run_mode": "auto",
      "idempotent": false,
      "idempotency_note": "保存附件后会标记已读，重跑取不到同一封邮件，请先恢复未读状态",
      "reversible": true,
      "reversibility_note": "附件与标记已读均可重新生成或改回"
    },
    {
      "id": "3",
      "type": "sap.export",
      "pad_hint": "Scripting.RunVBScript.RunVBScript",
      "intent": "sap-export",
      "label": "Run the export transaction script",
      "params": {
        "VBScriptCode": "WScript.Echo \"export done to {{variables.ExcelPath}}\""
      },
      "output_skip": [
        "ScriptError",
        "ScriptOutput"
      ],
      "next": [
        "4"
      ],
      "branch": null,
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true,
      "reversibility_note": "每次生成新的带时间戳导出文件，旧文件可直接删除"
    },
    {
      "id": "4",
      "type": "excel.launch",
      "pad_hint": "Excel.LaunchExcel.LaunchAndOpen",
      "label": "Open the SAP export in Excel",
      "params": {
        "Path": "{{variables.ExcelPath}}",
        "Visible": false
      },
      "outputs": [
        "ExcelInstance"
      ],
      "next": [
        "5"
      ],
      "branch": null,
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "5",
      "type": "excel.read",
      "pad_hint": "Excel.ReadFromExcel.ReadAllCells",
      "label": "Read all data from the Excel file",
      "params": {
        "FirstLineIsHeader": true
      },
      "outputs": [
        "ExcelData"
      ],
      "next": [
        "6"
      ],
      "branch": null,
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "6",
      "type": "branch",
      "pad_hint": "IF",
      "label": "Any differences?",
      "params": {
        "Condition": "ExcelData.Count > 0"
      },
      "next": [
        "8"
      ],
      "branch": {
        "condition": "ExcelData.Count > 0",
        "true": "7",
        "false": "8",
        "body": [
          "7"
        ]
      },
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "7",
      "type": "excel.color",
      "pad_hint": "Excel.SetColor.SetColorRangePredefined",
      "label": "Highlight differing rows in red",
      "params": {
        "StartRow": 2,
        "EndRow": "ExcelData.Count + 1",
        "StartColumn": 1,
        "EndColumn": 5,
        "ColorName": "Red"
      },
      "outputs": [],
      "next": [
        "8"
      ],
      "branch": null,
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true,
      "reversibility_note": "标色可直接改回或重新生成文件"
    },
    {
      "id": "8",
      "type": "excel.close",
      "pad_hint": "Excel.CloseExcel.CloseAndSave",
      "label": "Save and close Excel",
      "params": {},
      "outputs": [],
      "next": [
        "9"
      ],
      "branch": null,
      "run_mode": "auto",
      "idempotent": true,
      "reversible": true
    },
    {
      "id": "9",
      "type": "mail.send",
      "pad_hint": "Outlook.SendEmailThroughOutlook.SendEmail",
      "label": "Email the reconciliation result to the manager",
      "params": {
        "SendTo": "{{variables.ManagerEmail}}",
        "Subject": "{{variables.Month}} 对账结果",
        "Body": "{{variables.Month}} 对账已完成，详见附件。",
        "IsBodyHtml": false
      },
      "outputs": [],
      "next": [],
      "branch": null,
      "run_mode": "auto",
      "idempotent": false,
      "idempotency_note": "每重跑一次会再发一封对账邮件",
      "reversible": false,
      "reversibility_note": "邮件已发出无法撤回，只能补发一封说明"
    }
  ]
}
