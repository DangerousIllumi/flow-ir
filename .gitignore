# ── Business layer: real flows, business configuration, internal docs, output and logs ────────────
# Never committed by default; the push gate additionally hard-blocks files under it (exit code 2)
business/

# Local real-word list for the push gate (business names / real paths / accounts); only the placeholder version ships
tools/publish/public-safe.denylist.local.json

# PAD action knowledge base: referenced by source only, never committed
pad-robin-action-kb/

# Node dependencies (ELK layout for flow diagrams only)
node_modules/

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Generator default output and runtime artifacts
out.robin
Results/
*.log
!tests/fixtures/telemetry/*.log
